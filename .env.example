# Copy to .env and fill in. Everything is optional for local development:
# without R2_BUCKET the app stores the index and flows under ./data/blobs.

# --- Cloudflare R2 (S3-compatible API) ---
# Create an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # only if you need a custom endpoint
# INDEX_KEY=index/skills.db
# FLOW_PREFIX=flows/

# --- Visual flow generation ---
FLOW_GENERATOR=anthropic        # anthropic | openai | stub (offline placeholder flow)
ANTHROPIC_API_KEY=              # for FLOW_GENERATOR=anthropic
OPENAI_API_KEY=                 # for FLOW_GENERATOR=openai (or export it in your shell)
FLOW_MODEL=                     # default: claude-opus-5 (anthropic) or gpt-5.4-mini (openai)
FLOW_EFFORT=high                # reasoning effort: low | medium | high (xhigh | max where supported)
FLOW_MAX_TOKENS=64000
FLOW_CONCURRENCY=2
# FLOW_BUILD_TOKEN=             # if set, the "Build visual flow" button asks for this token
# TAG_PROVIDER=                 # anthropic | openai; defaults to FLOW_GENERATOR
# TAG_MODEL=                    # used by `register --auto-tags`; defaults per provider

# --- GitHub (raises the API rate limit; the CLI falls back to `gh auth token`) ---
GITHUB_TOKEN=

# --- PostHog (public browser analytics) ---
POSTHOG_PROJECT_TOKEN=phc_your_public_project_token
POSTHOG_HOST=https://your-posthog-host

# --- Server ---
PORT=8787
# DATA_DIR=./data
# INDEX_REFRESH_SECONDS=300     # how often the server checks R2 for a newer index
